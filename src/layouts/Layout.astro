---
/*
 * Shared layout for every page: head, global styles, navigation, footer and
 * Webflow's runtime (jQuery + webflow.js, which powers the nav menu and
 * interactions).
 *
 * Props
 *   title, description   page <title> and meta description (also og/twitter)
 *   path                 URL path, e.g. "/about" (canonical + current nav link)
 *   ogImage              absolute URL of the social-share image
 *   wfPage               Webflow page ID; webflow.js uses it for interactions
 *   webflowJs            Webflow runtime bundle for this page in /assets/js/
 *   head, end            raw HTML: page-specific head tags, and scripts/elements after the footer
 *   bare                 404 page: no nav/footer
 */
import globalStyles from '../components/GlobalStyles.html?raw';
import navigation from '../components/Navigation.html?raw';
import footer from '../components/Footer.html?raw';

const {
  title, description = '', path, ogImage, wfPage, webflowJs,
  head = '', end = '', bare = false,
} = Astro.props;

const site = 'https://www.esthersimsstudio.co.uk';
const canonical = path ? new URL(path, site).href : undefined;
const body = await Astro.slots.render('default');

// Webflow marks the link to the current page with w--current + aria-current.
const markCurrent = (markup) =>
  path
    ? markup.replace(/<a ([^>]*?)href="([^"]*)"([^>]*)>/g, (tag, before, href, after) => {
        if (href !== path) return tag;
        const attrs = (before + after).replace(/class="([^"]*)"/, 'class="$1 w--current"');
        return `<a ${attrs.trim()} href="${href}" aria-current="page">`;
      })
    : markup;
---
<!DOCTYPE html>
<html data-wf-domain="www.esthersimsstudio.co.uk" data-wf-page={wfPage} data-wf-site="63ee391d6609d63fbc92b869" lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link href="/assets/css/shared.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/theme.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/site.css" rel="stylesheet" type="text/css" />
    <meta property="og:type" content="website"/>
    <meta content="summary_large_image" name="twitter:card"/>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    <meta content="eF-aROMQG2To9Sd7qLpQQztUIuASXx0hFvqWTXhaH8c" name="google-site-verification"/>
    <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/assets/media/6422d50b8fa8ddd3002670a6_Favicon.png" rel="shortcut icon" type="image/x-icon"/>
    <link href="/assets/media/6422d516302b2879c619c37e_Webclip.jpg" rel="apple-touch-icon"/>
    <style is:inline>
  html {
    opacity: 0;
    transition: opacity 150ms ease-out;
  }
  html.webflow-loaded {
    opacity: 1;
  }
  /* Respect users who've asked for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    html {
      transition: none;
    }
  }
</style>
    <script is:inline>
  (function () {
    // Ensure the Webflow queue exists even if webflow.js hasn't loaded yet
    window.Webflow = window.Webflow || [];

    function reveal() {
      document.documentElement.classList.add('webflow-loaded');
    }

    // Normal path: Webflow itself tells us when it's ready
    window.Webflow.push(reveal);

    // Safety net: if Webflow never calls back (blocked script, error, etc.)
    // force the page visible after 3s so users never see a blank screen
    window.setTimeout(reveal, 3000);
  })();
</script>
    <script is:inline async src="https://cdn.jsdelivr.net/npm/@finsweet/attributes-modal@1/modal.js"></script>
    <script is:inline defer src="https://ds-pulse.ds-pulse.workers.dev/s.js"></script>
    <script is:inline src="/assets/js/finsweetcomponentsconfig-1.0.15.js" type="module" async="" siteId="63ee391d6609d63fbc92b869" finsweet="components"></script>
    <Fragment set:html={head} />
  </head>
  <body>
    {!bare && <Fragment set:html={globalStyles} />}
    {!bare && <Fragment set:html={markCurrent(navigation)} />}
    {bare ? <Fragment set:html={body} /> : <div class="page-wrapper"><Fragment set:html={body} /></div>}
    {!bare && <Fragment set:html={markCurrent(footer)} />}
    <script is:inline src="/assets/js/jquery-3.5.1.min.js" type="text/javascript"></script>
    {webflowJs && <script is:inline src={`/assets/js/${webflowJs}.js`} type="text/javascript"></script>}
    <Fragment set:html={end} />
  </body>
</html>
